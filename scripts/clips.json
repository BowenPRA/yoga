 {
  "id": "warrior-2__en",
  "text": "Warrior II",
  "lang": "en",
  "kind": "pose-name"
 },
 {
  "id": "warrior-2__sa",
  "text": "Vīrabhadrāsana II",
  "say": "vee-rah-bah-DRAH-sah-nah TWO",
  "lang": "sa",
  "kind": "pose-name"
 },
 {
  "id": "warrior-2__cue-1",
  "text": "Step your feet wide apart.",
  "lang": "en",
  "kind": "cue-transition"
 },
 {
  "id": "warrior-2__cue-2",
  "text": "Turn your right toes out, and your left toes in slightly.",
  "lang": "en",
  "kind": "cue-alignment"
 },
 {
  "id": "warrior-2__cue-3",
  "text": "Bend your front knee so it stacks over your ankle.",
  "lang": "en",
  "kind": "cue-alignment"
 },
 {
  "id": "warrior-2__cue-4",
  "text": "Press into the outer edge of your back foot.",
  "lang": "en",
  "kind": "cue-alignment"
 },
 {
  "id": "warrior-2__cue-5",
  "text": "Reach your arms out wide, parallel to the floor.",
  "lang": "en",
  "kind": "cue-alignment"
 },
 {
  "id": "warrior-2__cue-6",
  "text": "Relax your shoulders away from your ears.",
  "lang": "en",
  "kind": "cue-soften"
 },
 {
  "id": "warrior-2__cue-7",
  "text": "Gaze softly over your front fingertips.",
  "lang": "en",
  "kind": "cue-alignment"
 },
 {
  "id": "warrior-2__cue-8",
  "text": "Stay here for five breaths.",
  "lang": "en",
  "kind": "cue-breath"
 },
 {
  "id": "warrior-2__mod-1",
  "text": "Shorten your stance if your front knee feels strained.",
  "lang": "en",
  "kind": "modification"
 },
 {
  "id": "warrior-2__mod-2",
  "text": "Rest your hands on your hips to give your shoulders a break.",
  "lang": "en",
  "kind": "modification"
 },
 {
  "id": "warrior-2__mod-3",
  "text": "You can sit on the edge of a chair with your front leg bent.",
  "lang": "en",
  "kind": "modification"
 },
 {
  "id": "warrior-2__safe-1",
  "text": "Keep your front knee tracking over your second toe. Don’t let it fall inward.",
  "lang": "en",
  "kind": "safety"
 },
 {
  "id": "warrior-2__safe-2",
  "text": "If you have a knee injury, don’t bend as deeply, and come out sooner.",
  "lang": "en",
  "kind": "safety"
 },
 {
  "id": "downward-dog__en",
  "text": "Downward-Facing Dog",
  "lang": "en",
  "kind": "pose-name"
 },
 {
  "id": "downward-dog__sa",
  "text": "Adho Mukha Śvānāsana",
  "say": "AH-doh MOO-kah shvah-NAH-sah-nah",
  "lang": "sa",
  "kind": "pose-name"
 },
 {
  "id": "downward-dog__cue-1",
  "text": "Tuck your toes and lift your hips up and back.",
  "lang": "en",
  "kind": "cue-transition"
 },
 {
  "id": "downward-dog__cue-2",
  "text": "Spread your fingers wide and press down through your knuckles.",
  "lang": "en",
  "kind": "cue-alignment"
 },
 {
  "id": "downward-dog__cue-3",
  "text": "Lengthen through your spine, and let your head hang heavy.",
  "lang": "en",
  "kind": "cue-alignment"
 },
 {
  "id": "downward-dog__cue-4",
  "text": "Bend your knees as much as you need to keep your back long.",
  "lang": "en",
  "kind": "cue-soften"
 },
 {
  "id": "downward-dog__cue-5",
  "text": "Reach your heels toward the floor. They don’t have to touch.",
  "lang": "en",
  "kind": "cue-alignment"
 },
 {
  "id": "downward-dog__cue-6",
  "text": "Rotate your upper arms outward to make space for your neck.",
  "lang": "en",
  "kind": "cue-alignment"
 },
 {
  "id": "downward-dog__cue-7",
  "text": "Stay for five breaths. Breathe into the back of your body.",
  "lang": "en",
  "kind": "cue-breath"
 },
 {
  "id": "downward-dog__mod-1",
  "text": "Keep your knees bent and your heels lifted if the back of your legs feels tight.",
  "lang": "en",
  "kind": "modification"
 },
 {
  "id": "downward-dog__mod-2",
  "text": "Place your hands on blocks to take weight off your wrists.",
  "lang": "en",
  "kind": "modification"
 },
 {
  "id": "downward-dog__mod-3",
  "text": "Come to your forearms, or rest in Puppy Pose with your knees down.",
  "lang": "en",
  "kind": "modification"
 },
 {
  "id": "downward-dog__safe-1",
  "text": "If your wrists hurt, press through your knuckles and fingertips, not the heel of your hand.",
  "lang": "en",
  "kind": "safety"
 },
 {
  "id": "downward-dog__safe-2",
  "text": "Late in pregnancy, keep the hold short, or choose a gentler option.",
  "lang": "en",
  "kind": "safety"
 },
 {
  "id": "sleeping-swan__en",
  "text": "Sleeping Swan",
  "lang": "en",
  "kind": "pose-name"
 },
 {
  "id": "sleeping-swan__sa",
  "text": "Eka Pāda Rājakapotāsana",
  "say": "EH-kah PAH-dah rah-jah-kah-poh-TAH-sah-nah",
  "lang": "sa",
  "kind": "pose-name"
 },
 {
  "id": "sleeping-swan__cue-1",
  "text": "Bring your right knee forward, behind your right wrist.",
  "lang": "en",
  "kind": "cue-transition"
 },
 {
  "id": "sleeping-swan__cue-2",
  "text": "Let your shin angle back toward your left hip. It doesn’t need to be parallel.",
  "lang": "en",
  "kind": "cue-alignment"
 },
 {
  "id": "sleeping-swan__cue-3",
  "text": "Walk your back leg straight behind you.",
  "lang": "en",
  "kind": "cue-alignment"
 },
 {
  "id": "sleeping-swan__cue-4",
  "text": "Fold forward slowly, and rest on your forearms or your forehead.",
  "lang": "en",
  "kind": "cue-transition"
 },
 {
  "id": "sleeping-swan__cue-5",
  "text": "Find your edge. Enough to feel it, not so much that you tense against it.",
  "lang": "en",
  "kind": "cue-soften"
 },
 {
  "id": "sleeping-swan__cue-6",
  "text": "Let the muscles go soft. We’re here for three minutes.",
  "lang": "en",
  "kind": "cue-soften"
 },
 {
  "id": "sleeping-swan__cue-7",
  "text": "If you feel any sharp pain in your knee, come out of the pose.",
  "lang": "en",
  "kind": "cue-safety"
 },
 {
  "id": "sleeping-swan__cue-8",
  "text": "To come out, press your hands down and slowly lift up.",
  "lang": "en",
  "kind": "cue-transition"
 },
 {
  "id": "sleeping-swan__mod-1",
  "text": "Place a bolster or a folded blanket under your front hip so your hips stay level.",
  "lang": "en",
  "kind": "modification"
 },
 {
  "id": "sleeping-swan__mod-2",
  "text": "Rest your forehead on a block or on your stacked fists.",
  "lang": "en",
  "kind": "modification"
 },
 {
  "id": "sleeping-swan__mod-3",
  "text": "If the knee complains, lie on your back and take Eye of the Needle instead.",
  "lang": "en",
  "kind": "modification"
 },
 {
  "id": "sleeping-swan__safe-1",
  "text": "The sensation belongs in the outer hip. Pain in the knee means come out.",
  "lang": "en",
  "kind": "safety"
 },
 {
  "id": "sleeping-swan__safe-2",
  "text": "Come out slowly. After a long hold the joint needs a moment.",
  "lang": "en",
  "kind": "safety"
 }
]